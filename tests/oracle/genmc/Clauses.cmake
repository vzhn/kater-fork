# Writes OUT: a class CLASS derived from the checker BASE, which Kater
# exported to HEADER, that gives the verdict of each of its error and
# warning clauses (checkErrorN(), checkWarningN(), declared in the order of
# the exports) as a ClauseChecker.
#
#   cmake -DHEADER=... -DBASE=... -DCLASS=... -DOUT=... -P Clauses.cmake
file(STRINGS ${HEADER} lines REGEX "bool check(Error|Warning)[0-9]+\\(const EventLabel \\*lab\\) const")
set(calls "")
foreach(line IN LISTS lines)
  if(line MATCHES "bool (check(Error|Warning)[0-9]+)\\(")
    string(APPEND calls "\t\t\t${CMAKE_MATCH_1}(lab),\n")
  endif()
endforeach()

file(WRITE ${OUT}.new
  "/* Generated by Clauses.cmake from ${BASE}.hpp */\n"
  "#include \"ClauseChecker.hpp\"\n"
  "#include \"${BASE}.hpp\"\n\n"
  "class ${CLASS} : public ${BASE}, public ClauseChecker {\n"
  "public:\n"
  "\tusing ${BASE}::${BASE};\n\n"
  "\t[[nodiscard]] auto clauses(const EventLabel *lab) const -> std::vector<bool> override\n"
  "\t{\n"
  "\t\treturn {\n"
  "${calls}"
  "\t\t};\n"
  "\t}\n"
  "};\n")
file(COPY_FILE ${OUT}.new ${OUT} ONLY_IF_DIFFERENT)
