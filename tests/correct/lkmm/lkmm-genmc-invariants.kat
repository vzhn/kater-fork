// Invariants of kat/lkmm-genmc.kat that GenMC's exploration relies on.
// Each assertion failed on the revision of lkmm-genmc.kat before the fix
// named with it, and holds since.

include "../../../kat/lkmm-genmc.kat"

// GenMC's prefix (ppo) carries every dependency of a write, an RMW's write
// included: herd7's addr, data and ctrl reach it, while GenMC records them
// on the RMW's read. LKMM's own ppo (lkppo) has them too.
// (Fixed by "dependencies into an RMW reach its write".)
assert (addr | data | ctrl) ; rmw ; [W] <= lkmm-genmc::ppo
assert (addr | data | ctrl) ; rmw ; [W] <= lkmm-genmc::lkppo

// GenMC copies a thread's events only with its create: a prefix holding an
// event of a thread holds the thread's start, and a create holds what
// precedes it. (Fixed by "thread creation and join order the threads'
// events".)
assert [TB] ; po <= lkmm-genmc::ppo
assert po ; [TC] <= lkmm-genmc::ppo

// A parent's events before a create happen before the child's, so that no
// read can read from a thread created after it. Thread events carry atomic
// orderings in GenMC (release creates, acquire starts), which Kater does
// not know of TC and TB, hence the intersections. (Same fix.)
assert [ATOM] ; po ; [TC & ATOM] ; tc ; [TB & ATOM] ; po ; [ATOM] <= lkmm-genmc::lkhb+

// W ; smp_mb() ; pthread_create() orders like a release write.
// (Fixed by "strong fences reach thread creation and join".)
assert [W] ; po ; [lkmm-genmc::Fmb] ; po ; [TC] <= lkmm-genmc::strong-fence

// The revisit prefix orders nothing that LKMM leaves unordered, besides
// GenMC's thread and fence bookkeeping and the prefix-only control
// dependencies (pctrl): an ordering beyond LKMM's loses executions.
assert lkmm-genmc::ppo <= lkmm-genmc::lkppo | po ; [TC | TE] | [TB | TJ] ; po | rmw | [F] ; po | lkmm-genmc::pcdep

// The prefix a write's revisits take is part of the full one.
assert lkmm-genmc::rppo <= lkmm-genmc::ppo

// ---------------------------------------------------------------------
// The error rules
// ---------------------------------------------------------------------

// The write-write warning, VE_WWRace unless ww_conflict <= hb, compares
// the last marked writes of the other threads with GenMC's hb view,
// (po | rf | tc | tj | lin)+. The writes LKMM orders through program order
// and reads-from are in it, so the rule never flags them: a lock handover
// (po ; unlock ; rf ; lock ; po, into another thread or back into the
// same one), smp_store_release()/smp_load_acquire() and the release and
// acquire RMWs (xchg_release(), xchg_acquire(), ...: the same predicates
// on an RMW's write and read), a release sequence (cumul-fence), a strong
// fence before a message, smp_mb__after_unlock_lock() after a handover
// from another thread, thread creation and join.
// (Hold since "coherence over a po-only view; GenMC's ppo within po",
// which checks the rule against hb; the revision before it checked the
// same rule against a porf view, and they hold against that too. The
// heuristic that warned about these writes, GenMC #98, counted coherence
// placings in C++, outside the kat.)
assert [W] ; lkmm-genmc::po-unlock-lock-po-ext ; [W] <= lkmm-genmc::hb
assert [W] ; lkmm-genmc::po-unlock-lock-po ; [W] <= lkmm-genmc::hb
assert [W] ; lkmm-genmc::po-rel ; rf ; lkmm-genmc::acq-po ; [W] <= lkmm-genmc::hb
assert [W] ; po ; [lkmm-genmc::Rel & EXCL] ; rf ; [lkmm-genmc::Acq & EXCL] ; po ; [W] <= lkmm-genmc::hb
assert [W] ; lkmm-genmc::cumul-fence ; rfe ; lkmm-genmc::acq-po ; [W] <= lkmm-genmc::hb
assert [W] ; lkmm-genmc::strong-fence ; rfe ; [ATOM] ; po ; [W] <= lkmm-genmc::hb
assert [W] ; lkmm-genmc::mb-ext ; [W] <= lkmm-genmc::hb
assert [W] ; po ; [TC] ; tc ; [TB] ; po ; [W] <= lkmm-genmc::hb
assert [W] ; po ; [TE] ; tj ; [TJ] ; po ; [W] <= lkmm-genmc::hb

// In general: every chain of LKMM's hb but prop-int orders the writes
// within the rule's view (lkppo is within po but for mb-ext, a handover).
assert [W & ATOM] ; ([ATOM] ; (lkmm-genmc::lkppo | lkmm-genmc::thread-po | rfe | tc | tj) ; [ATOM])+ ; [W & ATOM] <= lkmm-genmc::hb

// Beyond the view, and so flagged although LKMM orders them: writes
// ordered through prop-int (a relation GenMC computes, opaque to Kater,
// and a path through moe or fre) or pb (which begins with moe or fre);
// [W & ATOM] ; lkhb+ ; [W & ATOM] <= hb fails on prop-int, and
// [W & ATOM] ; pb ; [W & ATOM] <= hb on moe. rc11-genmc.kat's rule has
// the same bound (ww_conflict <= porf). A grace period orders a reader's
// write in its critical section before an updater's write after
// synchronize_rcu() (rcu-order, not regular): GenMC decides that by hand
// (LKMMRcuChecker, GenMC #113).

// The freed-memory rules GenMC hand-writes (LKMMRcuChecker): a free with
// the last accesses of its block not hb-before it, and an access of a
// block with a free in the graph that the access is not hb-before, unless
// RCU orders them. Kater cannot state the second: free ; [R | W] <= hb^-1
// needs the free's view of the access, and an exported inclusion tests
// its left end against the view of the new event, the right end; the
// positional relations (free, alloc, retire, last_*) are printed only at
// the end of a traversal checked against a view or against 0; `\` and
// `&` have no NFA conversion (free \ po^-1 cannot be exported); and
// rcu-order is not regular. What such a rule's premise must exclude, an
// access po-before the free (a thread re-adding its accesses before a
// kept free, GenMC #96), is hb-before it:
assert [R | W] ; po ; [FREE] <= lkmm-genmc::hb
