// Extended coherence order
let eco = (rf | mo | fr)+

// ---------------------------------------------------------------------
// RC11 Happens-before
// ---------------------------------------------------------------------

// Optimized calculation of synchronizes-with
// Save the view of write messages

let relseq = [REL] ; ([F|TC] ; po)? ; (rf ; rmw)*
let sw_to_r = relseq ; rf ; [ACQ]
let sw_to_f = relseq ; rf ; po ; [F|TJ] ; [ACQ]
let sw = sw_to_r | sw_to_f
let asw = tc | tj | lin

assert sw = [REL] ; ([F|TC] ; po)? ; (rf ; rmw)* ; rf ; (po ; [F|TJ])? ; [ACQ]

// Happens-before
view hb = (po | sw_to_r | asw | sw_to_f)+

assert hb = (po | sw | asw)+

// Also save an 'abstract' hb that discards plock synchronization (relinche)
view hbRelinche = (po | tc | tj | lin
	| (relseq ; rf ; (po ; [F|TJ|TB])? ; [NPLK & ACQ]))+ (genmc: "if (!getConf()->collectLinSpec && !getConf()->checkLinSpec) lab->addView({}); else")

// ---------------------------------------------------------------------
// IMM Consistency axioms
// ---------------------------------------------------------------------

// A join is ordered as a fence is (vzhn/kater-fork#38): sw_to_f makes it
// synchronise as an acquire fence, so ppo must order the events before it,
// or a read GenMC adds into a hole before a join, reading from a release
// write, makes an ar cycle that reading from init does not (Kokologiannakis's
// thesis, Section 5.4.1: a dependency-tracking model's prefix must have
// the orderings its axioms add, MP-EXT)
let bob = po ; [REL] | [ACQ] ; po | po ; [F|TJ] | [F|TJ] ; po | [W;REL]; po-loc ; [W]

// GenMC explores IMM without the po? of addr ; po? (vzhn/kater-fork#38):
// with it, a read in a hole orders the event it depends on by address
// before the writes after it, whatever it reads, and GenMC can leave such a
// hole that no way of filling keeps consistent (imm-addr-po.graph). This
// weaker model is extensible; IMM's own ar, with addr ; po?, is exported
// as an extra check (arFull below) that GenMC makes of a complete execution
// and of the graph of an error, after Bouajjani et al. (2023), as Mixer
// (POPL 2025, Section 2.4) describes
let deps = data | ctrl | addr | rmw
let ppo = [DEP] ; (deps | rfi)+ ; [W] | bob | detour
let depsFull = data | ctrl | addr ; po? | rmw
let ppoFull = [DEP] ; (depsFull | rfi)+ ; [W] | bob | detour

// assert rmw <= ppo
// assert detour <= ppo
// assert [R]; po; [W&REL] <= ppo

// No OOTA
// acyclic (ppo | rf)

// Coherence : Optimize the checking of irreflexive (hb ; eco)
export coherence hb

// RMW atomicity
// check  mo-imm ; [UW] <= rf ; po-imm

// global ordering constraint
let FSC = [F] ; [SC]
let fhb = [F] ; hb
let hbf = hb ; [F]
let scb = po | rf | mo | fr
let psc = [SC] ; po ; hb ; po ; [SC]
        | [SC] ; fhb? ; scb ; hbf? ; [SC]
        | FSC ; hb ; FSC
        | FSC ; hb ; eco ; hb ; FSC
        | SC ; po ; SC
export acyclic psc unless [SC];any;[SC] <= id

let ar = rfe | ppo | FSC ; hb ; eco ; hb ; FSC
export acyclic ar

// IMM's ar, which is not extensible (see deps above): not part of
// isConsistent(), GenMC calls arFull() itself
let arFull = rfe | ppoFull | FSC ; hb ; eco ; hb ; FSC
export extra arFull nonextensible acyclic arFull


// ---------------------------------------------------------------------
// IMM error detection
// ---------------------------------------------------------------------

// Same as RC11's (GenMC 0.19's IMMChecker has these errors as well)

view porf = (po | rf | tc | tj | lin)+

let na_conflict =
	last_na_reads; [W] |
	last_na_writes; [R | W] |
	last_at_reads; [NA & W] |
	last_at_writes; ([NA & R] | [NA & W])

let ww_conflict =
	last_at_writes; [W & ATOM]

let last_accesses =
	last_na_reads | last_na_writes | last_at_reads | last_at_writes

// GenMC needs to handle the no-alloc case (access validity)

export error VE_AccessNonMalloc unless  alloc <= hb
export error VE_DoubleFree      unless  free; [FREE|HPRET] = 0

export error VE_AccessFreed     unless  last_accesses; [FREE] <= hb
export error VE_AccessFreed     unless  free ; [R | W] = 0
export error VE_AccessFreed     unless  unprotected ; [HPRET] <= hb
export error VE_AccessFreed     unless  retire ; [NOTHPPROT] = 0 // FIXME: wrong

export error VE_RaceNotAtomic   unless  na_conflict <= hb
export warning VE_WWRace        unless  ww_conflict <= porf // hb
